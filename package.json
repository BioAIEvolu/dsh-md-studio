{
    "name":  "dsh-md-studio",
    "version":  "1.3.5",
    "description":  "Markdown Studio — 在 DSH 右侧预览与对话消息中渲染 Markdown、Mermaid 流程图、手写 SVG 图表组件、KaTeX 数学公式、GFM 表格与代码高亮。支持 mds-diagram 围栏直接渲染 SVG 架构图/流程图/示意图，附 mds-diagram-design 绘图规范 skill，完全离线。 / Markdown Studio — native DSH right-sidebar preview + in-chat rendering for Markdown, Mermaid diagrams, hand-written SVG diagram components (mds-diagram / bare SVG blocks), KaTeX math, GFM tables \u0026 syntax highlighting, with the bundled mds-diagram-design skill. Fully offline.",
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "dsh-plugin",
                     "markdown",
                     "md",
                     "preview",
                     "mermaid",
                     "diagram",
                     "flowchart",
                     "svg",
                     "svg-diagram",
                     "chart",
                     "katex",
                     "math",
                     "syntax-highlighting",
                     "code-highlight",
                     "gfm",
                     "table",
                     "footnote",
                     "offline"
                 ],
    "homepage":  "https://github.com/BioAIEvolu/dsh-md-studio#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/BioAIEvolu/dsh-md-studio.git"
                   },
    "bugs":  "https://github.com/BioAIEvolu/dsh-md-studio/issues",
    "license":  "MIT",
    "author":  "BioAIEvolu",
    "type":  "module",
    "main":  "./lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "skills",
                  "lib",
                  "docs/images",
                  "docs/demo.md",
                  "cordis.patch.yml",
                  "README.md",
                  "README.en.md",
                  "CHANGELOG.md",
                  "THIRD_PARTY_NOTICES.md"
              ],
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "test":  "node test/browser.mjs",
                    "screenshots":  "node test/screenshots.mjs"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
                                          ],
                               "external":  [
                                                "react"
                                            ]
                           }
            },
    "engines":  {
                    "node":  "\u003e=22.19.0",
                    "dsh":  "\u003e=0.2.0-rc.2 \u003c0.3.0-0"
                },
    "peerDependencies":  {
                             "react":  "^18.2.0 || ^19"
                         },
    "devDependencies":  {
                            "esbuild":  "0.28.2",
                            "mermaid":  "11.17.0",
                            "markdown-it":  "15.0.2",
                            "markdown-it-footnote":  "4.0.0",
                            "markdown-it-task-lists":  "2.1.1",
                            "dompurify":  "3.4.16",
                            "highlight.js":  "11.12.0",
                            "katex":  "0.19.0",
                            "react":  "18.3.1",
                            "react-dom":  "18.3.1",
                            "playwright-core":  "1.64.0"
                        }
}

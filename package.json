{
    "name":  "dsh-md-studio",
    "version":  "1.3.15",
    "description":  "Markdown renderer for DeepSeek Harness — 完整的 Markdown 渲染插件：DSH 右侧文件预览 + 对话消息双场景，支持 GFM 表格/任务列表/脚注/代码高亮、Mermaid 流程图、手写 SVG 架构图（mds-diagram）、KaTeX 数学公式，渲染引擎随包内置完全离线。 / Markdown renderer plugin for DeepSeek Harness — complete Markdown rendering for right-sidebar file preview + in-chat messages: GFM tables/task lists/footnotes/code highlighting, Mermaid diagrams, hand-written SVG architecture diagrams (mds-diagram), KaTeX math. Bundled rendering engine, fully offline.",
    "keywords":  [
                     "markdown",
                     "markdown-renderer",
                     "markdown-preview",
                     "markdown-editor",
                     "md",
                     "mdx",
                     "deepseek-harness",
                     "dsh",
                     "dsh-plugin",
                     "preview",
                     "mermaid",
                     "diagram",
                     "flowchart",
                     "svg",
                     "svg-diagram",
                     "chart",
                     "katex",
                     "math",
                     "syntax-highlighting",
                     "code-highlight",
                     "gfm",
                     "table",
                     "footnote",
                     "offline"
                 ],
    "homepage":  "https://github.com/BioAIEvolu/dsh-md-studio#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/BioAIEvolu/dsh-md-studio.git"
                   },
    "bugs":  "https://github.com/BioAIEvolu/dsh-md-studio/issues",
    "license":  "MIT",
    "author":  "BioAIEvolu",
    "type":  "module",
    "main":  "./lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "skills",
                  "lib",
                  "docs/images",
                  "docs/demo.md",
                  "cordis.patch.yml",
                  "README.md",
                  "README.en.md",
                  "CHANGELOG.md",
                  "THIRD_PARTY_NOTICES.md"
              ],
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "test":  "node test/browser.mjs",
                    "test:route":  "node test/runtime-route.mjs",
                    "test:diagram":  "node skills/mds-diagram-design/scripts/check-svg-contrast.mjs --self-test",
                    "screenshots":  "node test/screenshots.mjs"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
                                          ],
                               "external":  [
                                                "react"
                                            ]
                           }
            },
    "engines":  {
                    "node":  "\u003e=22.19.0",
                    "dsh":  "\u003e=0.2.2-rc.5 \u003c0.3.0-0"
                },
    "peerDependencies":  {
                             "react":  "^18.2.0 || ^19"
                         },
    "devDependencies":  {
                            "esbuild":  "0.28.2",
                            "mermaid":  "11.17.0",
                            "markdown-it":  "15.0.2",
                            "markdown-it-footnote":  "4.0.0",
                            "markdown-it-task-lists":  "2.1.1",
                            "dompurify":  "3.4.16",
                            "highlight.js":  "11.12.0",
                            "katex":  "0.19.0",
                            "react":  "18.3.1",
                            "react-dom":  "18.3.1",
                            "playwright-core":  "1.64.0"
                        }
}